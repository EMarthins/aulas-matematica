rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções auxiliares ----------
    function logado() {
      return request.auth != null;
    }
    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // Administrador do serviço: quem tem um documento em admins/{uid} (criado À MÃO no console do Firebase).
    // Serve para conceder o plano Pro a quem pagou (admin.html). Ninguém cria isso pelo site.
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Campos do plano: só o administrador muda (o professor NUNCA muda o próprio plano).
    function camposDoPlano() {
      return ['plano', 'planoAte', 'planoNota'];
    }
    // O aluno está APROVADO nessa turma? (lê a matrícula dele em teachers/{prof}/classes/{turma}/students/{uid})
    function aprovado(teacherUid, classId, uid) {
      let p = /databases/$(database)/documents/teachers/$(teacherUid)/classes/$(classId)/students/$(uid);
      return exists(p) && get(p).data.status == 'approved';
    }
    // A atividade foi atribuída a essa turma?
    function atividadeDaTurma(teacherUid, activityId, classId) {
      return get(/databases/$(database)/documents/teachers/$(teacherUid)/activities/$(activityId)).data.classIds.hasAny([classId]);
    }
    // Campos que o ALUNO pode gravar na própria submissão (correção e feedback são só do professor).
    function camposDoAluno() {
      return ['status', 'score', 'total', 'submittedAt', 'firstOpenedAt', 'entendimento',
              'resposta', 'linkArquivo', 'updatedAt', 'classId'];
    }
    function statusDoAluno(s) {
      return s in ['em-andamento', 'concluido', 'em-analise'];
    }

    // --- Consultas "collectionGroup" (buscam em TODAS as subcoleções com esse nome, de qualquer
    // professor). O Firestore exige esta sintaxe recursiva à parte: a regra aninhada normal
    // abaixo NÃO cobre esse tipo de consulta. ---

    // Aluno localiza uma turma pelo código de convite, antes de estar matriculado.
    match /{path=**}/classes/{classId} {
      allow read: if logado();
    }

    // Aluno lista as turmas em que já tem matrícula (a partir do próprio uid).
    match /{path=**}/students/{studentUid} {
      allow read: if dono(studentUid);
    }

    // --- Perfil do usuário (professor ou aluno) ---
    match /users/{uid} {
      allow read: if dono(uid) || admin();
      allow delete: if dono(uid); // o usuário pode excluir a própria conta (conta.html)
      // O papel só pode ser escolhido no cadastro e não muda depois.
      allow create: if dono(uid) && request.resource.data.role in ['aluno', 'professor'];
      allow update: if dono(uid) && request.resource.data.role == resource.data.role;
    }

    match /teachers/{teacherUid} {
      allow read: if dono(teacherUid) || admin();
      // Todo professor nasce no plano gratuito; só o administrador muda plano/planoAte/planoNota.
      allow create: if dono(teacherUid) && request.resource.data.plano == 'free' && !('planoAte' in request.resource.data);
      allow update: if (dono(teacherUid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(camposDoPlano())) ||
                       (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposDoPlano()));
      allow delete: if dono(teacherUid);

      // --- Provas, questões próprias e configurações do Proveiro (salvas na nuvem) ---
      match /provas/{provaId} {
        allow read, write: if dono(teacherUid);
      }
      match /questoes/{questaoId} {
        allow read, write: if dono(teacherUid);
      }
      match /config/{docId} {
        allow read, write: if dono(teacherUid);
      }

      // --- Turmas ---
      match /classes/{classId} {
        // Leitura liberada a qualquer usuário autenticado: é assim que o aluno acha a turma pelo
        // código antes de se matricular. Só há nome e código aqui, nada sensível.
        allow read: if logado();
        allow write: if dono(teacherUid);

        // --- Matrículas (aprovação de alunos) ---
        match /students/{studentUid} {
          allow read: if dono(teacherUid) || dono(studentUid);

          // O aluno só pode CRIAR a própria solicitação, sempre 'pending' e só com estes campos.
          allow create: if dono(studentUid) &&
            request.resource.data.uid == studentUid &&
            request.resource.data.status == 'pending' &&
            request.resource.data.keys().hasOnly(['uid', 'nome', 'email', 'status', 'requestedAt']);

          // Só o professor aprova/rejeita (muda o status) ou remove.
          allow update, delete: if dono(teacherUid);
          // O aluno pode remover a PRÓPRIA matrícula (sair da turma / excluir a conta).
          allow delete: if dono(studentUid);
        }
      }

      // --- Atividades ---
      match /activities/{activityId} {
        // A definição da atividade espelha uma aula pública; leitura a qualquer autenticado.
        allow read: if logado();
        allow write: if dono(teacherUid);

        // --- Submissões / notas ---
        match /submissions/{studentUid} {
          allow read: if dono(teacherUid) || dono(studentUid);

          // O professor escreve qualquer campo (correção).
          allow write: if dono(teacherUid);

          // O aluno só cria a PRÓPRIA submissão se estiver aprovado numa turma que recebeu esta
          // atividade (o id da turma vai no campo classId), com status válido e só campos permitidos.
          allow create: if dono(studentUid) &&
            request.resource.data.keys().hasOnly(camposDoAluno()) &&
            statusDoAluno(request.resource.data.status) &&
            request.resource.data.classId is string &&
            aprovado(teacherUid, request.resource.data.classId, studentUid) &&
            atividadeDaTurma(teacherUid, activityId, request.resource.data.classId);

          // Excluir a conta: o aluno pode apagar a PRÓPRIA submissão.
          allow delete: if dono(studentUid);

          // Atualização: só a própria, só campos permitidos, e nunca depois de corrigida pelo professor.
          allow update: if dono(studentUid) &&
            resource.data.status != 'corrigido' &&
            statusDoAluno(request.resource.data.status) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposDoAluno());
        }
      }
    }
  }
}
